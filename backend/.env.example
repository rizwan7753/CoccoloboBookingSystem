# MySQL connection — update credentials for your local/dev database
DATABASE_URL="mysql://root:password@localhost:3306/carambola_booking"

PORT=4000
NODE_ENV=development

# Admin auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

# Stripe (test mode keys — https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Frontend origin allowed for CORS
FRONTEND_ORIGIN="http://localhost:3000"

# Email (stubbed for MVP — logs to console if unset)
SENDGRID_API_KEY=""
EMAIL_FROM="bookings@carambola.example"
