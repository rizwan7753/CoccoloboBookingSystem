// Cocolobo Booking System — MVP schema
// Single-location MVP. `locationId` fields are kept in place (hardcoded to
// one seeded Location row) so multi-property support can be added later
// without a schema rewrite.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev; debian-openssl-1.0.x covers the older
  // CentOS/AlmaLinux-based cPanel host this also deploys to.
  binaryTargets = ["native", "debian-openssl-1.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ExcursionStatus {
  ACTIVE
  INACTIVE
  DRAFT
  SOLD_OUT
}

// PER_GUEST: amountTotal = priceAdult*adultCount + priceChild*childCount (default).
// FLAT_RATE: amountTotal = priceAdult, a single flat charge for the whole
// booking regardless of adult/child split — e.g. a cabana priced "$400 for up
// to 4 guests" rather than per person. capacityDefault still caps how many
// guests can be on one booking (spec: "Private or exclusive-group pricing" §5).
enum PricingType {
  PER_GUEST
  FLAT_RATE
}

enum SlotStatus {
  OPEN
  CLOSED
  SOLD_OUT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum BookingSource {
  DIRECT_WEBSITE
  STAFF_ASSISTED
  HOTEL_CONCIERGE
  TRAVEL_AGENT
  CRUISE
}

// Roles are now admin-managed rows rather than a fixed enum (§14 Staff Roles &
// Permissions has become user-editable). Five built-in roles are seeded with the
// same ids the old AdminRole enum used (SUPER_ADMIN, LOCATION_MANAGER,
// BOOKING_STAFF, FINANCE, TRAVEL_AGENT) so existing admin_users.role values kept
// working unchanged across the migration — see lib/permissions.ts for the fixed
// catalog of permission keys a role can be granted.
model Role {
  id         String   @id @default(cuid())
  name       String   @unique
  // Built-in roles (seeded at migration time) can't be renamed or deleted from
  // the admin UI, only have their permissions adjusted — keeps the five
  // historical roles from disappearing out from under existing staff accounts.
  isSystem   Boolean  @default(false)
  createdAt  DateTime @default(now())

  permissions RolePermission[]
  adminUsers  AdminUser[]

  @@map("roles")
}

model RolePermission {
  id         String @id @default(cuid())
  roleId     String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String // one of the keys in lib/permissions.ts's PERMISSIONS list

  @@unique([roleId, permission])
  @@map("role_permissions")
}

model Location {
  id        String      @id @default(cuid())
  name      String      // doubles as the booking system's display name (single-location MVP)
  timezone  String      @default("America/St_Thomas")
  currency  String      @default("USD")
  createdAt DateTime    @default(now())

  // SMTP config for sending guest/staff notifications (confirmations, reminders).
  // smtpPassword is write-only from the admin UI's perspective — the GET
  // endpoint never echoes it back, only whether one is set.
  smtpHost       String?
  smtpPort       Int?
  smtpUsername   String?
  smtpPassword   String?
  smtpFromEmail  String?
  smtpFromName   String?
  smtpSecure     Boolean     @default(false)

  // Which payment methods guests can choose at checkout. If both are on,
  // the guest picks one; if only one is on, it's used without asking.
  stripeEnabled              Boolean @default(true)
  offlinePaymentEnabled      Boolean @default(false)
  offlinePaymentInstructions String? @db.Text // guest-visible bank/deposit instructions
  offlinePaymentReceiptEmail String?          // guest sends their payment receipt here, referencing the booking ID
  adminNotificationEmail    String?          // staff get a "new booking" email here when set; unset = no admin notifications

  // Stripe API keys — configurable here instead of only via env vars/.env, so
  // they can be changed without a redeploy. DB value takes priority over the
  // .env fallback (see stripeService.resolveSecretKey). Publishable key is
  // not secret (it's meant to be public, sent to the browser); secretKey and
  // webhookSecret are write-only from the admin UI's perspective, same
  // pattern as smtpPassword above — never echoed back, only whether one is set.
  stripePublishableKey String?
  stripeSecretKey      String?
  stripeWebhookSecret  String?

  // NMI — a second card gateway alongside Stripe, using Collect.js for
  // client-side tokenization (same PCI-friendly shape as Stripe Elements).
  // tokenizationKey is the public key Collect.js loads with (safe to expose);
  // securityKey is the private API key used server-side to charge the token
  // — write-only from the admin UI, same pattern as stripeSecretKey.
  nmiEnabled         Boolean @default(false)
  nmiTokenizationKey String?
  nmiSecurityKey     String?
  // NMI is a white-label platform — sandbox accounts and many resellers use
  // their own gateway domain rather than secure.nmi.com. Both the server-side
  // charge endpoint and the Collect.js script are served from this same
  // domain. Defaults to secure.nmi.com when unset.
  nmiGatewayDomain String?

  excursions Excursion[]
  rentalItems RentalItem[]
  events      Event[]
  adminUsers AdminUser[]
  holidays    Holiday[]
  restaurantMenus        RestaurantMenu[]
  restaurantReservations RestaurantReservation[]

  @@map("locations")
}

// A closed/blackout date (holiday, weather closure, private charter, etc.)
// at the location level — set once, blocks booking wherever it applies
// rather than needing to be configured on every excursion/rental/event
// individually. The three booleans let an admin scope a closure (e.g. "beach
// chairs stay open on Christmas but tours don't") instead of always
// shutting down everything.
model Holiday {
  id                  String   @id @default(cuid())
  locationId          String
  location            Location @relation(fields: [locationId], references: [id])
  date                DateTime @db.Date
  label               String   // "Christmas Day"
  appliesToExcursions Boolean  @default(true)
  appliesToRentals    Boolean  @default(true)
  appliesToEvents     Boolean  @default(true)
  createdAt           DateTime @default(now())

  @@unique([locationId, date])
  @@map("holidays")
}

model Excursion {
  id                String           @id @default(cuid())
  locationId        String
  location          Location         @relation(fields: [locationId], references: [id])
  title             String
  slug              String           @unique
  description       String           @db.Text
  included          String?          @db.Text
  excluded          String?          @db.Text
  durationMinutes   Int
  meetingPoint      String?          @db.Text
  mapUrl            String?
  whatToBring       String?          @db.Text
  images            Json?            // array of image URLs
  cardImageUrl      String?          // shown on the public listing card
  headerImageUrl    String?          // shown at the top of the detail page
  pricingType       PricingType      @default(PER_GUEST)
  priceAdult        Decimal          @db.Decimal(10, 2) // flat total when pricingType = FLAT_RATE
  priceChild        Decimal?         @db.Decimal(10, 2) // ignored when pricingType = FLAT_RATE
  capacityDefault   Int
  cutoffHoursBefore Int              @default(0) // hours before departure that booking closes; combined with cutoffTime
  cutoffTime        String           @default("21:00") // "book by 9:00 PM the evening before"
  status            ExcursionStatus  @default(DRAFT)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  departureTimes    DepartureTime[]
  slots             DepartureSlot[]
  bookings          Booking[]

  @@map("excursions")
}

// Recurring weekly schedule: this excursion runs at `time` on the given days of week.
model DepartureTime {
  id           String    @id @default(cuid())
  excursionId  String
  excursion    Excursion @relation(fields: [excursionId], references: [id], onDelete: Cascade)
  time         String    // "09:00" 24h format
  daysOfWeek   Json      // e.g. [1,2,3,4,5] (0=Sun .. 6=Sat)
  isActive     Boolean   @default(true)

  @@map("departure_times")
}

// A concrete bookable instance: one excursion, one date, one time.
// Created lazily (upserted) the first time it's requested/booked.
// Row locked via SELECT ... FOR UPDATE during booking to prevent oversell.
model DepartureSlot {
  id           String       @id @default(cuid())
  excursionId  String
  excursion    Excursion    @relation(fields: [excursionId], references: [id])
  date         DateTime     @db.Date
  time         String
  capacity     Int
  bookedCount  Int          @default(0)
  status       SlotStatus   @default(OPEN)
  createdAt    DateTime     @default(now())

  bookings     Booking[]

  @@unique([excursionId, date, time])
  @@map("departure_slots")
}

model Booking {
  id               String        @id @default(cuid())
  excursionId      String
  excursion        Excursion     @relation(fields: [excursionId], references: [id])
  slotId           String
  slot             DepartureSlot @relation(fields: [slotId], references: [id])

  guestName        String
  guestEmail       String
  guestPhone       String?
  roomNumber       String?
  specialRequests  String?       @db.Text

  adultCount       Int           @default(0)
  childCount       Int           @default(0)
  totalGuests      Int

  amountTotal      Decimal       @db.Decimal(10, 2)
  currency         String        @default("USD")

  status           BookingStatus @default(PENDING)
  paymentStatus    PaymentStatus @default(PENDING)
  stripePaymentIntentId String?  @unique
  paymentMethod    String?       // "stripe" | "offline" — informational only, not indexed
  bookingCode      String?       @unique // human-readable reference, e.g. COCO_EXC_20260903_0007 — see lib/bookingCode.ts

  source           BookingSource @default(DIRECT_WEBSITE)
  internalNotes    String?       @db.Text

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([excursionId])
  @@index([slotId])
  @@map("bookings")
}

// Beach chairs / cabanas / umbrellas — same guest-type pricing as excursions,
// but booked per-day against a specific numbered spot rather than a shared
// capacity pool, and bookable same-day (no advance-booking cutoff).
model RentalItem {
  id          String           @id @default(cuid())
  locationId  String
  location    Location         @relation(fields: [locationId], references: [id])
  name        String
  slug        String           @unique
  description String           @db.Text
  images      Json?
  cardImageUrl   String?
  headerImageUrl String?
  durationMinutes Int          @default(240) // length of one booking session; used to auto-generate time slots
  priceAdult  Decimal          @db.Decimal(10, 2)
  priceChild  Decimal?         @db.Decimal(10, 2)
  status      ExcursionStatus  @default(DRAFT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  spots       RentalSpot[]
  timeSlots   RentalTimeSlot[]
  bookings    RentalBooking[]

  @@map("rental_items")
}

// A bookable time window for a rental item (e.g. "Morning", 09:00-13:00).
// Capacity is tracked per (spot, date, timeSlot) — the same physical chair
// can be booked separately in the morning and afternoon, same as an
// excursion's capacity resets per departure time rather than being shared
// across the whole day.
model RentalTimeSlot {
  id           String          @id @default(cuid())
  rentalItemId String
  rentalItem   RentalItem      @relation(fields: [rentalItemId], references: [id], onDelete: Cascade)
  label        String          // "Morning"
  startTime    String          // "09:00"
  endTime      String          // "13:00"
  isActive     Boolean         @default(true)

  bookings     RentalBooking[]

  @@unique([rentalItemId, label])
  @@map("rental_time_slots")
}

// A named spot/row (e.g. "Row A"), holding `quantity` chairs — not
// necessarily one chair each. A booking can take more than one chair from a
// spot's pool (up to however many are left for that date); the remaining
// count is computed live as quantity minus the sum of that day's bookings.
model RentalSpot {
  id           String          @id @default(cuid())
  rentalItemId String
  rentalItem   RentalItem      @relation(fields: [rentalItemId], references: [id], onDelete: Cascade)
  code         String          // "Row A - Chairs 1-5"
  quantity     Int             @default(1) // total chairs available at this spot
  isActive     Boolean         @default(true)

  bookings     RentalBooking[]

  @@unique([rentalItemId, code])
  @@map("rental_spots")
}

model RentalBooking {
  id             String        @id @default(cuid())
  rentalItemId   String
  rentalItem     RentalItem    @relation(fields: [rentalItemId], references: [id])
  spotId         String
  spot           RentalSpot    @relation(fields: [spotId], references: [id])
  timeSlotId     String
  timeSlot       RentalTimeSlot @relation(fields: [timeSlotId], references: [id])
  date           DateTime      @db.Date

  guestName      String
  guestEmail     String
  guestPhone     String?
  roomNumber     String?

  adultCount     Int           @default(1)
  childCount     Int           @default(0)
  quantity       Int           @default(1) // chairs reserved by this booking (= adultCount + childCount)

  amountTotal    Decimal       @db.Decimal(10, 2)
  currency       String        @default("USD")

  status         BookingStatus @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)
  stripePaymentIntentId String? @unique
  paymentMethod  String?       // "stripe" | "offline" — informational only, not indexed
  bookingCode    String?       @unique // human-readable reference, e.g. COCO_BCH_20260903_0007 — see lib/bookingCode.ts

  source         BookingSource @default(DIRECT_WEBSITE)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Concurrency safety here works like excursion capacity (see
  // bookingService.createBooking): the spot row is locked with
  // SELECT ... FOR UPDATE inside a transaction, remaining capacity for
  // (spotId, date, timeSlotId) is computed from the sum of non-cancelled
  // bookings, and only then is this row inserted. Cancelling DELETES the row
  // (rather than flagging CANCELLED) so the sum frees up again — the audit
  // log keeps a full snapshot for history.
  @@index([spotId, date, timeSlotId])
  @@index([rentalItemId, date])
  @@map("rental_bookings")
}

// One-off dated happenings (parties, galas, live music nights, workshops) —
// unlike excursions these have a single fixed date rather than a recurring
// weekly schedule, and are bookable right up to the event (no advance-booking
// cutoff). Ticketing is tier-based: even a "simple" single-price event is
// just an event with one EventTicketTier.
model Event {
  id          String            @id @default(cuid())
  locationId  String
  location    Location          @relation(fields: [locationId], references: [id])
  title       String
  slug        String            @unique
  description String            @db.Text
  images      Json?
  cardImageUrl   String?
  headerImageUrl String?
  eventDate   DateTime          @db.Date
  startTime   String            // "19:00"
  endTime     String?           // optional, for display only
  venue       String?           @db.Text
  mapUrl      String?
  status      ExcursionStatus   @default(DRAFT)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  ticketTiers EventTicketTier[]
  bookings    EventBooking[]

  @@index([eventDate])
  @@map("events")
}

// A ticket type for one event (e.g. "General Admission" $25, "VIP" $75,
// "Table for 6" $400) — each tier has its own price and its own capacity.
model EventTicketTier {
  id          String         @id @default(cuid())
  eventId     String
  event       Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String         // "General Admission"
  description String?        @db.Text
  price       Decimal        @db.Decimal(10, 2)
  capacity    Int
  isActive    Boolean        @default(true)

  bookings    EventBooking[]

  @@unique([eventId, name])
  @@map("event_ticket_tiers")
}

model EventBooking {
  id             String        @id @default(cuid())
  eventId        String
  event          Event         @relation(fields: [eventId], references: [id])
  tierId         String
  tier           EventTicketTier @relation(fields: [tierId], references: [id])

  guestName      String
  guestEmail     String
  guestPhone     String?
  roomNumber     String?

  quantity       Int           @default(1) // tickets purchased at this tier

  amountTotal    Decimal       @db.Decimal(10, 2)
  currency       String        @default("USD")

  status         BookingStatus @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)
  stripePaymentIntentId String? @unique
  paymentMethod  String?       // "stripe" | "offline" — informational only, not indexed
  bookingCode    String?       @unique // human-readable reference, e.g. COCO_EVT_20260903_0007 — see lib/bookingCode.ts

  source         BookingSource @default(DIRECT_WEBSITE)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Same concurrency pattern as rental bookings: the tier row is locked with
  // SELECT ... FOR UPDATE inside a transaction, remaining capacity computed
  // from the sum of non-cancelled bookings, only then is this row inserted.
  // Cancelling DELETES the row so that sum frees back up — audit log keeps
  // a full snapshot for history.
  @@index([tierId])
  @@index([eventId])
  @@map("event_bookings")
}

model AdminUser {
  id           String    @id @default(cuid())
  locationId   String?
  location     Location? @relation(fields: [locationId], references: [id])
  email        String   @unique
  passwordHash String
  name         String
  // Stores a Role.id — kept the column name/type-compatible "role" (now a plain
  // string instead of the old AdminRole enum) so the migration is a column-type
  // change with no data remapping: the enum's string values already match the
  // seeded built-in Role ids.
  role         String   @default("BOOKING_STAFF")
  roleRef      Role     @relation(fields: [role], references: [id])
  createdAt    DateTime @default(now())
  isActive     Boolean  @default(true)

  @@map("admin_users")
}

// Audit trail for booking-affecting actions (§14/§18: who did what, when).
// entityType/entityId are a loose polymorphic reference (e.g. "Booking"/<id>,
// "Excursion"/<id>) rather than a hard FK, since one log spans several entity types.
model AuditLog {
  id          String   @id @default(cuid())
  adminUserId String? // null for guest-initiated actions (e.g. a self-service booking)
  actorLabel  String // denormalized name/email or "Guest" — survives the admin user being deleted later
  action      String // e.g. "booking.created", "booking.cancelled", "excursion.updated"
  entityType  String
  entityId    String
  detail      Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([adminUserId])
  @@map("audit_logs")
}

// Backs the human-readable booking codes (COCO_<type>_<yyyymmdd>_<serial>) —
// id is the deterministic "<type>_<yyyymmdd>" key, so an atomic
// INSERT...ON DUPLICATE KEY UPDATE against it (see lib/bookingCode.ts) is
// enough to hand out a gapless per-day-per-type serial with no extra locking.
model BookingSequence {
  id      String @id
  type    String
  dateKey String
  counter Int    @default(0)

  @@map("booking_sequences")
}

// A named menu (Dinner Menu, Lunch Menu, Children's Menu, Seasonal Specials,
// etc.) shown under the site's "Restaurant" nav dropdown. Structured as
// Menu -> Sections (Seafood, Desserts, ...) -> Items (name/description/price)
// rather than free text, so the guest-facing page can lay out a real
// two-column priced menu instead of just rendering a text block.
model RestaurantMenu {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  title       String // "Dinner Menu"
  slug        String   @unique
  description String?  @db.Text // short overview shown at the top of the menu page
  timings     String?  // e.g. "7:00 AM - 11:00 AM"
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sections RestaurantMenuSection[]

  @@index([locationId])
  @@map("restaurant_menus")
}

// A category within a menu (e.g. "Seafood", eyebrow subheading "Fresh from
// the ocean"). Deleting a menu/section cascades to its sections/items — the
// admin save flow always replaces a menu's whole section list wholesale
// (same pattern as Excursion.departureTimes), so nothing needs to survive
// independently of its parent.
model RestaurantMenuSection {
  id         String         @id @default(cuid())
  menuId     String
  menu       RestaurantMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  heading    String // "Seafood"
  subheading String? // "Fresh from the ocean"
  sortOrder  Int            @default(0)

  items RestaurantMenuItem[]

  @@index([menuId])
  @@map("restaurant_menu_sections")
}

model RestaurantMenuItem {
  id          String                @id @default(cuid())
  sectionId   String
  section     RestaurantMenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name        String
  description String?               @db.Text
  price       Decimal?              @db.Decimal(10, 2)
  sortOrder   Int                   @default(0)

  @@index([sectionId])
  @@map("restaurant_menu_items")
}

// A table reservation enquiry — no payment, no live seat availability/count.
// Staff follow up by phone/email to actually confirm the table; `status`
// just tracks where that follow-up stands.
model RestaurantReservation {
  id              String   @id @default(cuid())
  locationId      String
  location        Location @relation(fields: [locationId], references: [id])
  bookingCode     String?  @unique // human-readable reference, e.g. COCO_RES_20260904_0007 — see lib/bookingCode.ts
  guestName       String
  guestEmail      String
  guestPhone      String?
  partySize       Int
  date            DateTime @db.Date
  time            String
  specialRequests String?  @db.Text
  status          String   @default("NEW") // NEW | CONTACTED | CONFIRMED | DECLINED
  createdAt       DateTime @default(now())

  @@index([locationId, date])
  @@map("restaurant_reservations")
}
